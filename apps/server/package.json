{
  "name": "@chat-bot/server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "npm run build && node --watch dist/main.js",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "build:test": "rm -rf dist-test && tsc -p tsconfig.spec.json",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "test": "npm run build:test && node --test \"dist-test/**/*.test.js\"",
    "test:watch": "npm run build:test && node --test --watch \"dist-test/**/*.test.js\"",
    "clean": "rm -rf dist dist-test node_modules"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@chat-bot/shared": "*"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@types/express": "^5.0.6",
    "@types/koa": "^3.0.3",
    "@types/node": "^20.0.0",
    "express": "^5.1.0",
    "fastify": "^5.11.2",
    "koa": "^3.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typescript": "^5.0.0"
  }
}
