{
  "name": "@chat-bot/ai-service",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "uvicorn app.main:app --reload --port 8000",
    "lint": "eslint \"{app,tests}/**/*.py\" --fix",
    "format": "prettier --write \"{app,tests}/**/*.py\"",
    "test": "pytest",
    "test:watch": "pytest-watch",
    "clean": "find . -type d -name __pycache__ -exec rm -rf {} + || true"
  },
  "dependencies": {
    "fastapi": "^0.115.0",
    "uvicorn": "^0.30.0",
    "httpx": "^0.27.0",
    "pydantic": "^2.0.0",
    "pydantic-settings": "^2.0.0",
    "slowapi": "^0.1.9"
  },
  "devDependencies": {
    "pytest": "^8.0.0",
    "pytest-asyncio": "^0.23.0",
    "pytest-cov": "^5.0.0"
  }
}
