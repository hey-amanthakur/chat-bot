# OpenRouter
OPENROUTER_API_KEY=sk-or-xxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Admin Auth
ADMIN_EMAIL=admin@example.com
# Generate with: npm run build && node apps/api-gateway/dist/scripts/hash-password.js <password>
# Accepts both bcrypt ($2b$...) and scrypt$ prefixed hashes
ADMIN_PASSWORD_HASH=$2b$10$xxxxx
JWT_SECRET=your-32-byte-hex-secret-here
JWT_EXPIRES_IN=24h

# Server
PORT=3000
NODE_ENV=development
# Comma-separated origins; restrict in production (empty = deny cross-origin)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Data (optional, defaults to ../../data/clients relative to apps/api-gateway)
# DATA_DIR=/path/to/data/clients
# LEADS_DATA_DIR=/path/to/data/leads
