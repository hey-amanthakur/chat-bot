{
  "name": "@chat-bot/api-gateway",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "npm run build && node --watch dist/main.js",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "build:test": "rm -rf dist-test && tsc -p tsconfig.spec.json",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "test": "npm run build:test && node --test \"dist-test/**/*.test.js\"",
    "test:watch": "npm run build:test && node --test --watch \"dist-test/**/*.test.js\"",
    "clean": "rm -rf dist dist-test node_modules"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
