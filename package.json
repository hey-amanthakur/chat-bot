{
  "name": "@hey-amanthakur/chat-bot",
  "version": "1.0.2",
  "description": "Embeddable AI chatbot for local businesses — install, configure, done",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hey-amanthakur/chat-bot.git"
  },
  "keywords": [
    "chatbot",
    "ai",
    "chat-widget",
    "customer-support",
    "local-business",
    "nestjs",
    "openrouter"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./widget": "./dist/widgets/chat-widget.min.js",
    "./widget.esm": "./dist/widgets/chat-widget.esm.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:widget": "cd widgets/chat-widget && npx rollup -c",
    "build:server": "cd apps/api-gateway && npx nest build",
    "build:copy": "cp -r apps/api-gateway/dist/* dist/ && mkdir -p dist/widgets && cp widgets/chat-widget/dist/* dist/widgets/",
    "build": "npm run build:server && mkdir -p dist/widgets && npm run build:widget && npm run build:copy",
    "dev": "turbo run dev",
    "lint": "cd apps/api-gateway && npm run lint",
    "test": "cd apps/api-gateway && npm test",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/throttler": "^5.0.0",
    "bcrypt": "^6.0.0",
    "class-validator": "^0.14.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/passport-jwt": "^4.0.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.8.0",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.0.0",
    "prettier": "^3.9.6",
    "rollup": "^4.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.0.0",
    "ts-loader": "^9.0.0",
    "ts-node": "^10.0.0",
    "tslib": "^2.6.0",
    "turbo": "^2.10.7",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.0.0"
}
