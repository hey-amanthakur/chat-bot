{
  "name": "@hey-amanthakur/chat-bot",
  "version": "1.0.4",
  "description": "Embeddable AI chatbot for local businesses — install, configure, done",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hey-amanthakur/chat-bot.git"
  },
  "keywords": [
    "chatbot",
    "ai",
    "chat-widget",
    "customer-support",
    "local-business",
    "openrouter"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./express": {
      "types": "./dist/adapters/express.d.ts",
      "import": "./dist/adapters/express.js",
      "require": "./dist/adapters/express.js",
      "default": "./dist/adapters/express.js"
    },
    "./fastify": {
      "types": "./dist/adapters/fastify.d.ts",
      "import": "./dist/adapters/fastify.js",
      "require": "./dist/adapters/fastify.js",
      "default": "./dist/adapters/fastify.js"
    },
    "./koa": {
      "types": "./dist/adapters/koa.d.ts",
      "import": "./dist/adapters/koa.js",
      "require": "./dist/adapters/koa.js",
      "default": "./dist/adapters/koa.js"
    },
    "./nestjs": {
      "types": "./dist/adapters/nestjs.d.ts",
      "import": "./dist/adapters/nestjs.js",
      "require": "./dist/adapters/nestjs.js",
      "default": "./dist/adapters/nestjs.js"
    },
    "./widget": "./dist/widgets/chat-widget.min.js",
    "./widget.esm": "./dist/widgets/chat-widget.esm.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:shared": "npm run build -w @chat-bot/shared",
    "build:widget": "npm run build -w @chat-bot/widget",
    "build:server": "npm run build -w @chat-bot/server",
    "build:copy": "rm -rf dist && mkdir -p dist/widgets && cp -r apps/server/dist/* dist/ && cp packages/widget/dist/* dist/widgets/",
    "build": "npm run build:shared && npm run build:server && npm run build:widget && npm run build:copy",
    "dev": "npm run dev -w @chat-bot/server",
    "test": "npm test -w @chat-bot/server",
    "clean": "rm -rf dist node_modules apps/server/dist apps/server/dist-test apps/server/node_modules packages/widget/dist packages/widget/node_modules packages/shared/dist packages/shared/node_modules"
  },
  "dependencies": {},
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/node": "^20.0.0",
    "rollup": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
