# OpenRouter
OPENROUTER_API_KEY=sk-or-xxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Admin Auth
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=$2b$10$xxxxx    # bcrypt hash
JWT_SECRET=your-32-byte-hex-secret-here
JWT_EXPIRES_IN=24h

# Server
PORT=3000
NODE_ENV=production
ALLOWED_ORIGINS=https://yourdomain.com

# Data (optional, defaults to /app/data/clients inside Docker)
# DATA_DIR=/app/data/clients
